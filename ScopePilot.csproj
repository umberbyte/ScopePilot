<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.11.2</Version>
    <AssemblyVersion>0.11.2.0</AssemblyVersion>
    <FileVersion>0.11.2.0</FileVersion>
    <Authors>umberbyte</Authors>
    <Copyright>Copyright (c) 2026, umberbyte</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <Description>Web診断の事前探索と診断対象候補の整理を支援するWindowsアプリ</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Include="Tests\**\*" Exclude="Tests\**\bin\**;Tests\**\obj\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="tools\playwright-runtime\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="LICENSE;THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="tools\fast-crawl.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyRuntimeLegalNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_LicenseRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' Or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <Error Condition="!Exists('%(_LicenseRuntimePack.PackageDirectory)/LICENSE') And !Exists('%(_LicenseRuntimePack.PackageDirectory)/LICENSE.TXT')" Text="Runtime license is missing for %(_LicenseRuntimePack.NuGetPackageId)." />
    <ItemGroup>
      <_RuntimeLegalDocument Include="%(_LicenseRuntimePack.PackageDirectory)/LICENSE*;%(_LicenseRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*">
        <LicensePackage>%(_LicenseRuntimePack.NuGetPackageId)</LicensePackage>
        <LicenseVersion>%(_LicenseRuntimePack.NuGetPackageVersion)</LicenseVersion>
      </_RuntimeLegalDocument>
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeLegalDocument)" DestinationFiles="@(_RuntimeLegalDocument->'$(PublishDir)licenses/dotnet/%(LicensePackage)/%(LicenseVersion)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
